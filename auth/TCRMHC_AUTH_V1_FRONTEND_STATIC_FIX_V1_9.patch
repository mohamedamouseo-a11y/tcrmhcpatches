diff --git a/apps/web/scripts/copy-public-assets.mjs b/apps/web/scripts/copy-public-assets.mjs
new file mode 100644
index 0000000..aaf4a9d
--- /dev/null
+++ b/apps/web/scripts/copy-public-assets.mjs
@@ -0,0 +1,18 @@
+import { cp, mkdir, stat } from "node:fs/promises";
+import { fileURLToPath } from "node:url";
+
+const sourceUrl = new URL("../../../public/assets/", import.meta.url);
+const destinationUrl = new URL("../dist/assets/", import.meta.url);
+
+const source = fileURLToPath(sourceUrl);
+const destination = fileURLToPath(destinationUrl);
+
+const sourceStats = await stat(source).catch(() => null);
+if (!sourceStats?.isDirectory()) {
+  throw new Error("TCRMHC public assets directory is missing");
+}
+
+await mkdir(destination, { recursive: true });
+await cp(source, destination, { recursive: true, force: true });
+
+console.log("TCRMHC public assets copied into the Vite dist tree.");
