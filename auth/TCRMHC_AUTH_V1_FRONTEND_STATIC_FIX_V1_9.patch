diff --git a/scripts/prepare-web-static-access.sh b/scripts/prepare-web-static-access.sh
new file mode 100755
index 0000000..248797b
--- /dev/null
+++ b/scripts/prepare-web-static-access.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+ROOT="${1:-/var/www/TCRMHC}"
+NGINX_USER="${2:-www-data}"
+DIST="$ROOT/apps/web/dist"
+
+if ! id "$NGINX_USER" >/dev/null 2>&1; then
+  echo "Nginx worker user does not exist: $NGINX_USER" >&2
+  exit 1
+fi
+
+if ! command -v setfacl >/dev/null 2>&1; then
+  echo "setfacl is required to grant least-privilege static-file access" >&2
+  exit 1
+fi
+
+if [[ ! -f "$DIST/index.html" || ! -d "$DIST/assets" ]]; then
+  echo "Built TCRMHC web dist is missing; run the web build first" >&2
+  exit 1
+fi
+
+for path in "$ROOT" "$ROOT/apps" "$ROOT/apps/web"; do
+  setfacl -m "u:${NGINX_USER}:--x" "$path"
+done
+
+setfacl -R -m "u:${NGINX_USER}:rX" "$DIST"
+setfacl -m "d:u:${NGINX_USER}:rX" "$DIST"
+
+echo "TCRMHC web static access prepared for the Nginx worker."
