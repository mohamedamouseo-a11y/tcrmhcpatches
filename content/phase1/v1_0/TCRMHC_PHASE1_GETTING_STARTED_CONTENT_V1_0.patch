+    sort_order
+  )
+  VALUES (
+    owner_tenant,
+    category_id,
+    'الأساسيات',
+    'Core Basics',
+    'tcrm-core-basics',
+    'الخطوات الأساسية التي يحتاجها أي مستخدم جديد قبل الانتقال إلى وحدات العمل المتخصصة.',
+    'The essential steps every new user needs before moving into specialized work modules.',
+    'active',
+    10
+  )
