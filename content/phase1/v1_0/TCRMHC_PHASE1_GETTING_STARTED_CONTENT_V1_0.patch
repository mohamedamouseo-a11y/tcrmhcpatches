+  )
+  VALUES (
+    owner_tenant,
+    module_id,
+    'البداية واستخدام TCRM',
+    'Getting Started with TCRM',
+    'tcrm-getting-started',
+    'ابدأ باستخدام TCRM وتعرّف على لوحة التحكم والتنقل وتسجيل الدخول والبحث واللغة والمظهر والإشعارات والصلاحيات.',
+    'Learn the TCRM basics: dashboard, navigation, sign-in, search, language, appearance, notifications, and role-based access.',
+    'active',
+    10
+  )
+  ON CONFLICT (tenant_id, slug) DO UPDATE
+  SET module_id = EXCLUDED.module_id,
+      title_ar = EXCLUDED.title_ar,
+      title_en = EXCLUDED.title_en,
